# Copy to keystore.properties and fill in to sign release builds.
# keystore.properties is git-ignored and must never be committed.
#
# 1) Generate a keystore (once):
#    keytool -genkeypair -v -keystore release.keystore -alias aiphoneagent \
#      -keyalg RSA -keysize 2048 -validity 10000
# 2) Copy this file to keystore.properties and set the values below.
# 3) Build: ./gradlew assembleRelease
#
# If keystore.properties is absent, assembleRelease falls back to the debug
# keystore so the APK is still installable for local testing.

storeFile=release.keystore
storePassword=changeit
keyAlias=aiphoneagent
keyPassword=changeit
