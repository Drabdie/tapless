   "source": [
    "# Сборка APK в Google Colab (автоматизированный ноутбук)\n",
    "\n",
    "Этот ноутбук автоматически: \n",
    "- Устанавливает OpenJDK 17 и Android command-line tools\n",
    "- Скачивает Android Platform 35 и Build-Tools 35.0.0\n",
    "- Клонирует репозиторий Drabdie/tapless и переключается на ветку DraD\n",
    "- Запускает скрипт сборки `./build-apk.sh` (сборка `assembleDebug`)\n",
    "- Выдаёт путь к APK, его размер и SHA-256, и предлагает скачать APK.\n",
    "\n",
    "Инструкция: откройте этот ноутбук в Colab (Open in Colab) и выполните все ячейки. Ноутбук рассчитан на чистую среду Colab.\n",
    "\n",
    "Важное: сборка может занимать 5–15 минут в зависимости от сети.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%bash\n",
    "set -euo pipefail\n",
    "echo 'Устанавливаем необходимые пакеты (OpenJDK 17, wget, unzip, git)...'\n",
    "apt-get update -qq\n",
    "apt-get install -y openjdk-17-jdk wget unzip git -qq\n",
    "java -version || true\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%bash\n",
    "set -euo pipefail\n",
    "export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64\n",
    "export ANDROID_SDK_ROOT=/root/android-sdk\n",
    "echo 'ANDROID_SDK_ROOT=' $ANDROID_SDK_ROOT\n",
    "mkdir -p $ANDROID_SDK_ROOT/cmdline-tools\n",
    "cd /tmp\n",
    "echo 'Скачиваем Android commandline tools... (несколько десятков МБ)'\n",
    "CMDLINE_ZIP=https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip\n",
    "wget -q "$CMDLINE_ZIP" -O cmdline.zip\n",
    "unzip -q cmdline.zip -d $ANDROID_SDK_ROOT/cmdline-tools\n",
    "# Упакованный каталог называется cmdline-tools, переместим его в 'latest'\n",
    "if [ -d $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools ]; then\n",
    "  mv $ANDROID_SDK_ROOT/cmdline-tools/cmdline-tools $ANDROID_SDK_ROOT/cmdline-tools/latest\n",
    "fi\n",
    "export PATH=$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$PATH\n",
    "echo 'Устанавливаем platform-tools, platforms;android-35 и build-tools;35.0.0'\n",
    "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --sdk_root=$ANDROID_SDK_ROOT \"platform-tools\" \"platforms;android-35\" \"build-tools;35.0.0\" --verbose || true\n",
    "yes | $ANDROID_SDK_ROOT/cmdline-tools/latest/bin/sdkmanager --sdk_root=$ANDROID_SDK_ROOT --licenses || true\n",
    "echo 'Установка SDK завершена.'\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%bash\n",
    "set -euo pipefail\n",
    "export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64\n",
    "export ANDROID_SDK_ROOT=/root/android-sdk\n",
    "export PATH=$ANDROID_SDK_ROOT/platform-tools:$PATH\n",
    "echo 'Клонируем репозиторий и переключаемся на ветку DraD'\n",
    "git clone https://github.com/Drabdie/tapless.git\n",
    "cd tapless\n",
    "git fetch --all --tags || true\n",
    "git checkout DraD || git checkout -b DraD origin/DraD || true\n",
    "ls -la\n",
    "chmod +x build-apk.sh gradlew || true\n",
    "echo 'Запускаем ./build-apk.sh (сборка debug)...'\n",
    "./build-apk.sh\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "apk = Path('tapless/app/build/outputs/apk/debug/app-debug.apk')\n",
    "print('APK существует:', apk.exists())\n",
    "print('Путь к APK:', apk.resolve())\n",
    "import os\n",
    "if apk.exists():\n",
    "    print('\nРазмер и SHA-256:')\n",
    "    os.system('ls -lh "{}"'.format(apk))\n",
    "    os.system('sha256sum "{}"'.format(apk))\n",
    "    # Предложим скачать файл (Colab)\n",
    "    try:\n",
    "        from google.colab import files\n",
    "        files.download(str(apk))\n",
    "    except Exception as e:\n",
    "        print('files.download недоступен:', e)\n",
    "else:\n",
    "    print('\nОшибка: APK не найден. Посмотрите вывод предыдущих ячеек для диагностики.')\n"
   ]
  }
